# ────────────────────────────────────────────────────────────
# Mir AI Studio — Production Environment Variables
# Copy this file to `.env` (or `.env.local`) and fill real values.
# ────────────────────────────────────────────────────────────

# REQUIRED — PostgreSQL connection string
# Free options: Neon (neon.tech) · Supabase · Railway · PlanetScale
# Example: postgresql://user:password@ep-cool-name.region.neon.tech/app_db?sslmode=require
DATABASE_URL=

# Canonical production domain (used by sitemap.xml, robots.txt & share links)
# Example: https://mirai.app
NEXT_PUBLIC_SITE_URL=https://mirai.app
